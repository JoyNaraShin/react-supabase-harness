#!/usr/bin/env python3
"""실행 시점 rm 가드 — bash 가 해석을 다 끝낸 뒤 rm 이 **실제로 받은 인자**를 보고 판정한다.

정적 가드(hooks/block-destructive-git.py)는 명령 글자만 보고 bash 의 해석을 추측한다. 추측이 하나라도
어긋나면 구멍이 됐다(0.35.1–0.35.4 에서 세 번 연속). 이 래퍼는 추측하지 않는다 — 변수·따옴표·이어쓰기·
중괄호 확장은 이미 끝난 상태다. 두 층은 서로를 대신하지 않는다: 이 래퍼는 `/bin/rm` 처럼 PATH 를 거치지
않는 호출을 못 보고, 정적 가드는 그 호출을 본다.

SessionStart 훅(hooks/install-rm-guard.py)이 이 디렉터리를 PATH 앞에 둔다. 재귀 삭제(-r·-R·--recursive)만
판정하고, 위험하지 않으면 진짜 rm 을 그대로 실행한다.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)


def _policy():
    """정적 가드와 같은 정책(hooks/rmpolicy.py). 재귀 삭제를 판정할 때만 불러온다 — 불러오기가 깨져도
    재귀가 아닌 rm 은 그대로 돈다."""
    sys.path.insert(0, os.path.join(ROOT, "hooks"))
    import rmpolicy
    return rmpolicy


def real_rm() -> str:
    """이 래퍼가 아닌 rm. 테스트는 HARNESS_REAL_RM 으로 기록기를 끼운다 — 판정은 그 전에 끝나므로 우회 수단이 아니다."""
    if os.environ.get("HARNESS_REAL_RM"):
        return os.environ["HARNESS_REAL_RM"]
    for d in os.environ.get("PATH", "").split(os.pathsep):
        if not d or os.path.realpath(d) == HERE:
            continue
        p = os.path.join(d, "rm")
        if os.path.isfile(p) and os.access(p, os.X_OK) and os.path.realpath(p) != os.path.realpath(__file__):
            return p
    return "/bin/rm"


# 재귀가 아닌 것이 확실한 rm 긴 옵션(GNU coreutils rm --help 기준). 축약형은 재귀일 수 있어 여기 없다.
_KNOWN_LONG = {"force", "interactive", "one-file-system", "no-preserve-root", "preserve-root", "dir", "verbose",
               "help", "version"}


def parse(args: list):
    """(재귀 여부, 대상 목록). `--` 뒤는 모두 대상이다."""
    recursive, targets, opts = False, [], True
    for a in args:
        if opts and a == "--":
            opts = False
        elif opts and a.startswith("--"):
            # GNU getopt 는 모호하지 않은 긴 옵션 축약(`--recursive` 의 앞부분)을 받아들인다. 래퍼가 모르는 긴 옵션은
            # 재귀로 간주해 대상을 검사한다(fail-closed) — 판정이 실제 rm 의 해석보다 느슨해지지 않게.
            name = a[2:].split("=", 1)[0]
            recursive |= not name or "recursive".startswith(name) or name not in _KNOWN_LONG
        elif opts and a.startswith("-") and a != "-":
            recursive |= "r" in a[1:] or "R" in a[1:]
        else:
            targets.append(a)
    return recursive, targets


def why_dangerous(target: str, cwd: str, home: str):
    """위험하면 (이유 코드, 문구), 아니면 None. 판정은 hooks/rmpolicy.py — 프로젝트는 SessionStart 가 적은 값."""
    return _policy().runtime(target, cwd, home, os.environ.get("HARNESS_PROJECT_DIR", ""))


def main(argv: list) -> int:
    recursive, targets = parse(argv)
    if recursive:
        try:
            cwd = os.getcwd()
            home = os.environ.get("HOME", "")
            bad = [(t, r) for t in targets for r in [why_dangerous(t, cwd, home)] if r]
        except Exception as e:                           # 판정을 못 하면 재귀 삭제는 하지 않는다(fail closed)
            bad = [("?", ("system", f"판정 실패: {e}"))]
        if bad:
            t, (code, r) = bad[0]
            try:
                pol = _policy()
                nxt = f"{pol.NEXT.get(code, pol.NEXT['system'])} {pol.USER_RUN}"
            except Exception:
                nxt = "대상을 깊은 절대 경로로 다시 확인하라. 사용자가 의도한 삭제라면 사용자가 직접 `! /bin/rm -r …` 로 실행한다."
            sys.stderr.write(
                f"[react-supabase-harness] rm -r 차단 — 실제 대상 `{t}`: {r}.\n"
                "왜: 실행 시점 가드는 bash 가 해석을 끝낸 실제 인자를 본다(변수가 비었거나 경로가 위로 올라간 경우).\n"
                f"다음 행동: {nxt}"
                "(절대 경로 호출은 이 래퍼를 지나지 않고, 에이전트의 호출은 정적 가드가 따로 검사한다).\n")
            return 1
    rm = real_rm()
    os.execv(rm, [rm] + argv)
    return 127


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
